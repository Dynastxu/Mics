{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@mics/sdk": ["../../packages/sdk/src/index.ts"],
      "@mics/sdk/renderer": ["../../packages/sdk/src/renderer.ts"],
      "@mics/sdk/main": ["../../packages/sdk/src/main.ts"],
      "@mics/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.vue",
    "src/renderer/env.d.ts",
    "../../packages/sdk/src/index.ts",
    "../../packages/sdk/src/renderer.ts",
    "../../packages/sdk/src/contract/**/*.ts",
    "../../packages/sdk/src/global.d.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.vue"
  ]
}