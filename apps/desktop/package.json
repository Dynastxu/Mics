{
  "name": "@mics/desktop",
  "productName": "Mics",
  "author": "mics",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@cordisjs/plugin-fs-node": "^0.1.0",
    "@cordisjs/plugin-group": "^1.0.0",
    "@cordisjs/plugin-loader": "^1.0.0-rc.9",
    "@cordisjs/plugin-logger-console": "^1.0.0",
    "@cordisjs/plugin-timer": "^1.1.4",
    "@mics/plugin-loader": "workspace:*",
    "@mics/sdk": "workspace:*",
    "cordis": "4.0.0-rc.12",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@cordisjs/plugin-hmr": "^1.1.2",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "node-addon-require-builtin": "^0.1.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "build": {
    "appId": "com.github.mics",
    "productName": "MICS",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../../plugins",
        "to": "plugins",
        "filter": [
          "**/dist/**",
          "**/plugin.json"
        ]
      },
      {
        "from": "../../boot.config.json",
        "to": "boot.config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
