{
  "id": "mics.logger",
  "name": "日志",
  "version": "0.1.0",
  "description": "按启动分文件的日志服务：其它插件通过 ctx.logs 写入，启动阶段日志自动补录，渲染进程经 RPC 汇总，设置中可调整保留数量。",
  "author": "mics",
  "main": "dist/main.mjs",
  "renderer": "dist/renderer.mjs",
  "styles": ["dist/style.css"],
  "activation": ["*"],
  "essential": true,
  "dependencies": ["mics.kernel"],
  "contributes": {
    "nav": [
      {
        "id": "settings.logger",
        "group": "settings",
        "title": "日志设置",
        "icon": "activity",
        "order": 50
      }
    ],
    "configuration": {
      "title": "日志",
      "settingsView": "settings.logger",
      "properties": {
        "maxFiles": {
          "type": "integer",
          "title": "保留文件数",
          "description": "保留最近多少个日志文件",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "unit": "个"
        }
      }
    }
  }
}
