{
  "id": "mics.logger",
  "name": "日志",
  "description": "按启动分文件的日志观察者：主进程经 ctx.logger 输出、渲染进程经 ipc:log/write 事件写入，启动阶段日志自动补录；保留数量、目录与当前日志在通用设置页里调整。可随时禁用，禁用后只是不再落盘。",
  "author": "mics",
  "main": "dist/main.mjs",
  "renderer": "dist/renderer.mjs",
  "styles": ["dist/style.css"],
  "activation": ["*"],
  "permissions": {
    "trust": "sandboxed",
    "fs": {
      "read": ["${userData}/logs"],
      "write": ["${userData}/logs"]
    }
  },
  "dependencies": ["mics.kernel"],
  "contributes": {
    "configuration": {
      "title": "日志",
      "settingsView": "settings.general",
      "properties": {
        "maxFiles": {
          "type": "integer",
          "title": "保留文件数",
          "description": "保留最近多少个日志文件",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "unit": "个"
        }
      }
    }
  }
}
