{
  "id": "mics.launch",
  "name": "启动",
  "version": "0.1.0",
  "description": "实例扫描（未下载完成的实例可见但不可启动）、详情、日志与 Mod 查看、删除；启动页依赖账户插件，用所选账户的凭据启动，并在启动前自动校验、修复损坏的依赖文件。",
  "author": "mics",
  "main": "dist/main.mjs",
  "renderer": "dist/renderer.mjs",
  "styles": ["dist/style.css"],
  "dependencies": ["mics.kernel", "mics.shell", "mics.account"],
  "contributes": {
    "nav": [
      { "id": "launch", "title": "启动", "icon": "play", "order": 10 },
      {
        "id": "settings.launch",
        "group": "settings",
        "title": "启动设置",
        "icon": "sliders",
        "order": 30
      }
    ],
    "configuration": {
      "title": "启动",
      "settingsView": "settings.launch",
      "properties": {
        "repeatLaunchBehavior": {
          "type": "enum",
          "title": "重复启动行为",
          "description": "实例已在运行时再次点击开始游戏",
          "default": "prompt",
          "options": [
            { "value": "prompt", "label": "提示" },
            { "value": "launch", "label": "启动" },
            { "value": "ignore", "label": "忽略" }
          ]
        },
        "maxMemory": {
          "type": "integer",
          "title": "最大内存",
          "description": "传给游戏 JVM 的最大堆内存",
          "default": 4096,
          "minimum": 1024,
          "maximum": 32768,
          "unit": "MB"
        }
      }
    }
  }
}
