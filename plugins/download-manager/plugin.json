{
  "id": "mics.download.manager",
  "name": "下载管线",
  "version": "0.1.0",
  "description": "下载队列管理、进度追踪、SHA1 校验与断点续传；安装完成后写入实例就绪标记，失败可重试，已有实例可补全缺失文件。",
  "author": "mics",
  "main": "dist/main.mjs",
  "activation": ["onStartup"],
  "dependencies": ["mics.kernel"],
  "contributes": {
    "configuration": {
      "title": "下载",
      "properties": {
        "cacheDir": {
          "type": "string",
          "title": "缓存目录",
          "description": "留空使用默认缓存目录",
          "default": ""
        }
      }
    }
  }
}